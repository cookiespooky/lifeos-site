# /etc/nginx/sites-available/lifeos-site — сайт Life OS: готовые страницы из dist/. __DOMAIN__ подставляет scripts/deploy.sh.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    root /srv/lifeos-site;
    location / { try_files $uri $uri/ =404; }
}

server {
    # http2 включён глобально у соседних сайтов; повторять его здесь — warning на каждой перезагрузке nginx.
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;

    # Строки ssl_certificate допишет certbot --nginx прямо в этот файл на сервере. Поэтому deploy.sh копирует
    # его только при первой установке.

    root /srv/lifeos-site;
    index index.html;
    error_page 404 /404.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # Имена файлов не хешируются, и сайт пересобирается после каждого коммита в хранилище — кеш короткий,
    # чтобы выкладка была видна сразу.
    location / {
        expires 10m;
        try_files $uri $uri/ =404;
    }
}
